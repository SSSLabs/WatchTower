{
  "includeGitInstructions": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse-path-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
